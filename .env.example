# Адрес будущего API. Если пусто — приложение использует локальный JS-каталог.
VITE_API_BASE_URL=

# Публичные значения Supabase для подключения фронтенда.
# Сюда НЕ кладут service_role и НЕ кладут пароль базы данных.
# Реальные значения хранить только в локальном .env (файл в Git не входит).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
